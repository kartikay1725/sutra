# SUTRA Backend Environment Variables
# =====================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

APP_NAME=SUTRA
APP_ENV=development
DEBUG=true

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Redis (Upstash)
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# Authentication
JWT_SECRET=<at-least-32-random-chars>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EVENT_INTEGRITY_KEY=<at-least-32-random-chars>

# Storage
REPOSITORY_STORAGE_PATH=./data/repositories
SUTRA_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Groq AI
GROQ_API_KEY=<your-groq-api-key>

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-email>
SMTP_PASSWORD=<your-app-password>
SMTP_USE_TLS=true
EMAIL_SENDER=no-reply@sutra.dev

# Worker
WORKER_ENABLED=false
WORKER_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=100
WORKER_STALE_TIMEOUT_SECONDS=300
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_DELAY_SECONDS=2
WORKER_RETRY_MAX_DELAY_SECONDS=3600

# -----------------------------------------------------------------------
# GitHub App Configuration
# -----------------------------------------------------------------------
# Required for GitHub repository integration.
# Create a GitHub App at: https://github.com/settings/apps/new
# Install it at: https://github.com/settings/installations

# Your GitHub App's numeric ID (shown in App settings page)
GITHUB_APP_ID=

# Your GitHub App's slug — the URL-safe name shown in the app URL:
# https://github.com/apps/<slug>
# Required for the "Connect GitHub" button to work.
GITHUB_APP_SLUG=

# GitHub App private key (RSA PEM format)
# Either paste with literal newlines or use \n on a single line
GITHUB_PRIVATE_KEY_PEM=

# Webhook secret (set when creating the GitHub App)
GITHUB_WEBHOOK_SECRET=

# GitHub API base URL (leave as default unless using GitHub Enterprise)
GITHUB_API_BASE_URL=https://api.github.com

# For E2E tests only (optional)
GITHUB_TEST_REPO_OWNER=
GITHUB_TEST_REPO_NAME=
